# Copy this file to .env and fill in real values. Never commit .env.
# See lib/env.ts for validation and .agents/rules/security.md for handling rules.

# Postgres connection string (Prisma)
DATABASE_URL="postgresql://buildbridge:buildbridge@localhost:5432/buildbridge?schema=public"

# Redis connection string (BullMQ) — required to boot even though the queue
# itself isn't wired up until Phase P0a.
REDIS_URL="redis://localhost:6379"

# Anthropic Claude API key — never exposed to the client, only used from
# lib/ai/client.ts.
ANTHROPIC_API_KEY="sk-ant-..."

# When "true", lib/ai/client.ts returns canned fixture responses instead of
# calling Anthropic — see lib/ai/fixtures/ and the implementation plan's
# Fixture / Mock Strategy section. Leave unset/false to hit the real API.
USE_AI_FIXTURES="true"

# Auth.js session/JWT signing secret. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible object storage). Replace the endpoint's
# subdomain with your actual Cloudflare account ID — it must stay a
# syntactically valid URL (lib/env.ts rejects placeholders like
# "<account-id>" that aren't, since that would otherwise only surface as a
# build-time failure).
STORAGE_ACCESS_KEY="replace-me"
STORAGE_SECRET_KEY="replace-me"
STORAGE_BUCKET="buildbridge-design-assets"
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Resend — password-reset emails only. lib/email.ts sends from Resend's
# shared onboarding@resend.dev test sender by default; swap for a verified
# BuildBridge domain in production.
RESEND_API_KEY="re_..."
